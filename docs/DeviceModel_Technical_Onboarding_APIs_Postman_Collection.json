{
    "info": {
        "_postman_id": "9a2bd8c4-9e6f-4d59-b9a6-5b4f5ac9e101",
        "name": "DeviceModel Technical Onboarding APIs",
        "description": "Postman collection for DeviceModel technical onboarding request flow (manufacturer + superadmin).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "https://api.gromed.in"
        },
        {
            "key": "manufacturer_token",
            "value": ""
        },
        {
            "key": "superadmin_token",
            "value": ""
        },
        {
            "key": "onboarding_request_id",
            "value": "1"
        },
        {
            "key": "device_model_id",
            "value": "12"
        }
    ],
    "item": [
        {
            "name": "Manufacturer - Create Technical Onboarding Request",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{manufacturer_token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "device_model_id",
                            "value": "{{device_model_id}}",
                            "type": "text"
                        },
                        {
                            "key": "user_manual_pdf",
                            "type": "file",
                            "src": ""
                        },
                        {
                            "key": "ot_command_list_pdf",
                            "type": "file",
                            "src": ""
                        },
                        {
                            "key": "demo_devices",
                            "value": "[{\"device_serial_no\":\"SN-1001\",\"imei\":\"356938035643809\",\"ccid1\":\"8991101200003204512\",\"ccid2\":\"8991101200003204513\",\"msisdn1\":\"919876543210\",\"msisdn2\":\"919876543211\"}]",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/devicemodel/technical-onboarding/create/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "devicemodel",
                        "technical-onboarding",
                        "create",
                        ""
                    ]
                },
                "description": "Create onboarding request for one DeviceModel by manufacturer user. Required input: user_manual_pdf, ot_command_list_pdf, demo_devices."
            },
            "response": []
        },
        {
            "name": "Superadmin - List All Technical Onboarding Requests",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{superadmin_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/devicemodel/technical-onboarding/superadmin/list/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "devicemodel",
                        "technical-onboarding",
                        "superadmin",
                        "list",
                        ""
                    ]
                },
                "description": "Superadmin endpoint to fetch all onboarding requests with manufacturer/device model details and demo devices."
            },
            "response": []
        },
        {
            "name": "Superadmin - Mark Ongoing Evaluation",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{superadmin_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"onboarding_request_id\": {{onboarding_request_id}},\n  \"evaluation_datetime\": \"2026-02-25T12:30:00Z\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/devicemodel/technical-onboarding/superadmin/mark-ongoing/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "devicemodel",
                        "technical-onboarding",
                        "superadmin",
                        "mark-ongoing",
                        ""
                    ]
                },
                "description": "Move request status from submitted to ongoing_evaluation and set evaluation timestamp."
            },
            "response": []
        },
        {
            "name": "Superadmin - Finalize Request (Accept/Reject + Report Upload)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{superadmin_token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "onboarding_request_id",
                            "value": "{{onboarding_request_id}}",
                            "type": "text"
                        },
                        {
                            "key": "status",
                            "value": "accepted",
                            "type": "text"
                        },
                        {
                            "key": "final_comment",
                            "value": "Device model passed technical onboarding checks.",
                            "type": "text"
                        },
                        {
                            "key": "compatibility_report_pdf",
                            "type": "file",
                            "src": ""
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/devicemodel/technical-onboarding/superadmin/finalize/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "devicemodel",
                        "technical-onboarding",
                        "superadmin",
                        "finalize",
                        ""
                    ]
                },
                "description": "Finalize ongoing evaluation by uploading compatibility report, adding final comment, and setting accepted/rejected status."
            },
            "response": []
        },
        {
            "name": "Manufacturer - List Own Technical Onboarding Requests",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{manufacturer_token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/devicemodel/technical-onboarding/manufacturer/list/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "devicemodel",
                        "technical-onboarding",
                        "manufacturer",
                        "list",
                        ""
                    ]
                },
                "description": "Manufacturer endpoint to fetch only own onboarding requests with current statuses and details."
            },
            "response": []
        }
    ]
}