# Start from an official Python image
FROM python:3.9-slim-bullseye

# Install required system dependenciessudo apt-get install libmagic1
RUN apt-get update && apt-get install -y --no-install-recommends \
    wkhtmltopdf \          
    # for pdfkit
    #
    libssl-dev \          
    # often needed by cryptography/pycryptodome
    libffi-dev \    
    libmagic1 \
    # often needed by cryptography/pycryptodome
    build-essential \     
    # for compiling numpy/scipy if needed
    mosquitto-clients \
    # for MQTT user management
    #git \                  # if needed
    #nodejs \               # if needed
    #npm \                  # if needed
    # libreoffice          # uncomment if you need LibreOffice
    && rm -rf /var/lib/apt/lists/*




# Set the working directory in the container
WORKDIR /app

# Setup MQTT certificates directory and copy CA certificate
# Create directories for certificates
RUN mkdir -p /app/keys
RUN mkdir -p /etc/mosquitto/certs

# Copy certificate files - they are required for the MQTT client
COPY keys/ca.crt /app/keys/ca.crt

# Install Python dependencies BEFORE copying application code.
# This way Docker caches this layer and skips pip install on code-only changes.
# pip install only re-runs when requirements.txt itself changes.
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# Copy your Django project files into the container (including cert.pem & key.pem if needed)
# This includes:
# - skytron_api/mqtt_validate_views.py: MQTT JWT authentication endpoint
# - skytron_api/secure_token.py: RS256 JWT token management
# - skytron_api/urls.py: Routes for /api/mqtt/validate-connection/ and /api/mqtt/validate-acl/
COPY . /app

# Copy JWT RSA keys to the expected location for Django settings (BASE_DIR/keys/)
# These keys are required for RS256 JWT token signing and verification
# Used by secure_token.py for generating and validating JWT tokens
RUN mkdir -p /app/Skytronsystem/keys
COPY keys/jwt_private_key.pem /app/Skytronsystem/keys/jwt_private_key.pem
COPY keys/jwt_public_key.pem /app/Skytronsystem/keys/jwt_public_key.pem
RUN chmod 600 /app/Skytronsystem/keys/jwt_private_key.pem
RUN chmod 644 /app/Skytronsystem/keys/jwt_public_key.pem

# Copy MQTT Root CA certificate for secure TLS connection with certificate validation
# This root CA certificate is used by mqttClienttrack.py to validate the MQTT broker's certificate
# Part of proper certificate chain: Root CA → Intermediate CA → Server Certificate
# Security audit compliant: Enables certificate validation without tls_insecure_set()
# Note: Generate certificates with: cd .. && sudo ./generate_trusted_certificates.sh
# Then copy root CA: cp ../mqtt_certificates/root_ca/root_ca.crt ./root_ca.crt
COPY root_ca.crt /app/Skytronsystem/root_ca.crt
RUN chmod 644 /app/Skytronsystem/root_ca.crt


# Ensure certificates are available in both locations for compatibility
RUN cp /app/keys/ca.crt /etc/mosquitto/certs/ca.crt || cp /app/ca.crt /etc/mosquitto/certs/ca.crt || echo "Warning: CA certificate setup may need manual configuration"


# (Optional) If you need to collect static files, uncomment the line below:
RUN python manage.py collectstatic --noinput

# Expose port 2000
EXPOSE 2000

# Environment variables will be passed from system environment
ARG MAIL_ID
ARG MAIL_PW
ARG DEBUG
ARG SECRET_KEY
ARG EMAIL_HOST_USER
ARG EMAIL_HOST_PASSWORD
ARG ALLOWED_HOSTS
ARG DB_NAME
ARG DB_USER
ARG DB_PASSWORD
ARG DB_HOST
ARG DB_PORT
ARG MQTT_BROKER_HOST
ARG MQTT_BROKER_PORT
ARG MQTT_ADMIN_USER
ARG MQTT_ADMIN_PASS
ARG MQTT_USERNAME
ARG MQTT_PASSWORD
ARG SMS_URL
ARG SMS_USERID
ARG SMS_PASSWORD
ARG SMS_SENDER
ARG SMS_PEID
ARG ROOT_URL
ARG JWT_SECRET_KEY
ARG JWT_ALGORITHM
ARG JWT_ACCESS_TOKEN_LIFETIME
ARG JWT_REFRESH_TOKEN_LIFETIME
ARG MINIO_ENDPOINT
ARG MINIO_ACCESS_KEY
ARG MINIO_SECRET_KEY
ARG MINIO_BUCKET
ARG MINIO_SECURE
ARG ALLOWALLDEVMQTT

ENV MAIL_ID=${MAIL_ID}
ENV MAIL_PW=${MAIL_PW}
ENV DEBUG=${DEBUG}
ENV SECRET_KEY=${SECRET_KEY}
ENV EMAIL_HOST_USER=${EMAIL_HOST_USER}
ENV EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD}
ENV ALLOWED_HOSTS=${ALLOWED_HOSTS}
ENV DB_NAME=${DB_NAME}
ENV DB_USER=${DB_USER}
ENV DB_PASSWORD=${DB_PASSWORD}
ENV DB_HOST=${DB_HOST}
ENV DB_PORT=${DB_PORT}
ENV MQTT_BROKER_HOST=${MQTT_BROKER_HOST}
ENV MQTT_BROKER_PORT=${MQTT_BROKER_PORT}
ENV MQTT_ADMIN_USER=${MQTT_ADMIN_USER}
ENV MQTT_ADMIN_PASS=${MQTT_ADMIN_PASS}
ENV MQTT_USERNAME=${MQTT_USERNAME}
ENV MQTT_PASSWORD=${MQTT_PASSWORD}
ENV SMS_URL=${SMS_URL}
ENV SMS_USERID=${SMS_USERID}
ENV SMS_PASSWORD=${SMS_PASSWORD}
ENV SMS_SENDER=${SMS_SENDER}
ENV SMS_PEID=${SMS_PEID}
ENV ROOT_URL=${ROOT_URL}
ENV JWT_SECRET_KEY=${JWT_SECRET_KEY}
ENV JWT_ALGORITHM=${JWT_ALGORITHM}
ENV JWT_ACCESS_TOKEN_LIFETIME=${JWT_ACCESS_TOKEN_LIFETIME}
ENV JWT_REFRESH_TOKEN_LIFETIME=${JWT_REFRESH_TOKEN_LIFETIME}
ENV MINIO_ENDPOINT=${MINIO_ENDPOINT}
ENV MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
ENV MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
ENV MINIO_BUCKET=${MINIO_BUCKET}
ENV MINIO_SECURE=${MINIO_SECURE}
ENV ALLOWALLDEVMQTT=${ALLOWALLDEVMQTT}
